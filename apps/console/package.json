    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@edict/arbiter": "*",
    "@edict/core": "*",
    "@edict/evidence": "*",
    "@edict/linter": "*",
    "@edict/sdk": "*"
  }
}
