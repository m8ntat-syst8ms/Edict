{
  "name": "@edict/console",
  "version": "0.0.1",
  "private": true,
  "description": "Local Edict policy, case inspection, and sandbox dispute console",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "edict-console": "dist/cli.js"
  },
  "files": [
    "dist",
    "static"
  ],
  "scripts": {
