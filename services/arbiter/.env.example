# @edict/arbiter provider keys. Copy to .env (never commit .env).
# When a key is absent the CLI substitutes the deterministic MockProvider for
# that providerId, so the whole pipeline still runs offline.

# NEAR AI Cloud — https://cloud-api.near.ai/v1
NEARAI_API_KEY=
# Required when NEARAI_API_KEY is set: comma/space-separated recovered signer
# addresses/public keys accepted for NEAR AI receipts.
EDICT_SIGNER_ALLOWLIST_NEARAI=

# Phala Cloud Confidential AI via the RedPill ACI gateway — base URL default
# https://api.redpill.ai/v1. This must be
# an inference API key, not a cloud-management credential.
PHALA_API_KEY=
# Required when PHALA_API_KEY is set: comma/space-separated recovered signer
# addresses/public keys accepted for Phala/RedPill ACI receipts.
EDICT_SIGNER_ALLOWLIST_PHALA=

# Self-hosted Edict dstack node. The API key is optional on a
# private network; the signer allowlist is required for attested runs.
# The base URL must include /v1.
EDICT_NODE_BASE_URL=
EDICT_NODE_API_KEY=
EDICT_SIGNER_ALLOWLIST_EDICT_NODE=

# Optional base-URL overrides
# NEARAI_BASE_URL=https://cloud-api.near.ai/v1
# PHALA_BASE_URL=https://api.redpill.ai/v1
