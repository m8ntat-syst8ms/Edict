# Required in production: 32-byte AES key, lowercase hex.
EDICT_EVIDENCE_KEY_HEX=
EDICT_RUNTIME_API_TOKEN=

# Observation and scheduling.
NEAR_RPC_URL=https://free.rpc.fastnear.com
EDICT_INTENTS_CONNECTOR_ID=near-intents-mainnet
EDICT_RUNTIME_POLL_MS=15000
EDICT_RUNTIME_DATA_DIR=

# Live attested jury providers. Configure at least the providers named by the
# registered Protection Profile; keys are never persisted by the runtime.
NEARAI_API_KEY=
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
PHALA_API_KEY=
PHALA_BASE_URL=https://api.redpill.ai/v1
EDICT_NODE_BASE_URL=
EDICT_NODE_API_KEY=

# JSON array: [{"id":"operator-a","url":"https://signer-a.example/sign"}, ...]
EDICT_EXECUTION_SIGNERS_JSON=[]

# Optional gas-only permissionless relay. This service must not accept a
# customer key or arbitrary destination.
EDICT_RELAYER_URL=
EDICT_RELAYER_TOKEN=

# JSON array: [{"id":"customer","url":"https://customer.example/edict","secretEnv":"CUSTOMER_WEBHOOK_SECRET"}]
EDICT_WEBHOOKS_JSON=[]
CUSTOMER_WEBHOOK_SECRET=
